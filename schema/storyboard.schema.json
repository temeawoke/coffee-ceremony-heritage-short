{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Heritage Short Storyboard",
  "type": "object",
  "required": [
    "project",
    "shots"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": [
        "title",
        "language",
        "subtitle_language",
        "target_duration_seconds",
        "aspect_ratios",
        "visual_style"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "language": {
          "type": "string",
          "minLength": 2
        },
        "subtitle_language": {
          "type": "string",
          "minLength": 2
        },
        "target_duration_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 90
        },
        "aspect_ratios": {
          "type": "array",
          "items": {
            "enum": [
              "9:16",
              "16:9"
            ]
          },
          "minItems": 2,
          "uniqueItems": true
        },
        "visual_style": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "shots": {
      "type": "array",
      "minItems": 8,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": [
          "id",
          "duration_seconds",
          "visual_description",
          "image_prompt",
          "motion_prompt",
          "narration_am",
          "subtitle_en",
          "music_cue",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^shot_[0-9]{2}$"
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "visual_description": {
            "type": "string",
            "minLength": 1
          },
          "image_prompt": {
            "type": "string",
            "minLength": 1
          },
          "motion_prompt": {
            "type": "string",
            "minLength": 1
          },
          "narration_am": {
            "type": "string",
            "minLength": 1
          },
          "subtitle_en": {
            "type": "string",
            "minLength": 1
          },
          "music_cue": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}